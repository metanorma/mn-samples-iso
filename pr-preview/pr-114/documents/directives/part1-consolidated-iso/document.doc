<div align="center" class="table_container"><table class="MsoISOTable" style="mso-table-anchor-horizontal:column;mso-table-overlap:never;border-spacing:0;border-width:1px;"><a name="_c55fb7a8-9997-5e94-7894-5dd1ae563f5a" id="_c55fb7a8-9997-5e94-7894-5dd1ae563f5a"></a><thead><tr><th valign="middle" align="center" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;page-break-after:avoid;"><div class="Tableheader" style="page-break-after:avoid">Material Resource costs</div></th><th valign="middle" align="center" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;page-break-after:avoid;"><div class="Tableheader" style="page-break-after:avoid">Numbers</div></th><th valign="middle" align="center" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;page-break-after:avoid;"><div class="Tableheader" style="page-break-after:avoid">Estimated Cost per meeting</div></th><th valign="middle" align="center" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;page-break-after:avoid;"><div class="Tableheader" style="page-break-after:avoid">Covered by &#x2026; (Who)</div></th><th valign="middle" align="center" style="font-weight:bold;border-top:solid windowtext 1.5pt;mso-border-top-alt:solid windowtext 1.5pt;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;page-break-after:avoid;"><div class="Tableheader" style="page-break-after:avoid">Commitment (Y/N)</div></th></tr></thead><tbody><tr><td valign="top" align="left" style="border-top:solid w