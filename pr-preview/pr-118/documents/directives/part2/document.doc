    <m:r><m:t>R</m:t></m:r><m:r><m:t>=</m:t></m:r><m:r><m:t>2,5</m:t></m:r><m:r><m:rPr><m:sty m:val="p"></m:sty></m:rPr><m:t><span style="font-style:normal;">&#x2126;</span></m:t></m:r>
  </m:oMath></span></p>
