  </m:oMath></span></p>
</td><td valign="top" align="left" style="border-top:none;mso-border-top-alt:none;border-bottom:solid windowtext 1.5pt;mso-border-bottom-alt:solid windowtext 1.5pt;page-break-after:auto;"><p class="Tablebody" style="text-align: left;page-break-after:auto;page-break-after:auto"><a name="_479df3b9-2df8-963a-1940-7e64f747a84b" id="_479df3b9-2df8-963a-1940-7e64f747a84b"></a>Incorrect:<br/>
<span class="stem"><m:oMath>
    <m:r><m:t>24</m:t></m:r><m:r><m:rPr><m:sty m:val="p"></m:sty></m:rPr><m:t><span style="font-style:normal;">mm</span></m:t></m:r>
  </m:oMath></span><br/>
<span class="stem"><m:oMath>
    <m:r><m:t>&#xD7;</m:t></m:r><m:r><m:t>36</m:t></m:r><m:r><m:rPr><m:sty m:val="p"></m:sty></m:rPr><m:t><span style="font-style:normal;">mm</span></m:t></m:r>
  </m:oMath></span></p>
</td></tr></tbody></table></div>
</div>
</td>
